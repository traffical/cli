{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traffical Metrics Config",
  "description": "Schema for .traffical/metrics.yaml",
  "type": "object",
  "required": ["version", "metrics"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "fact_sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/FactSource"
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/Metric"
      }
    }
  },
  "definitions": {
    "FactSource": {
      "type": "object",
      "required": ["sql", "timestamp_column"],
      "additionalProperties": false,
      "properties": {
        "sql": { "type": "string" },
        "timestamp_column": { "type": "string" },
        "description": { "type": "string" },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column"],
            "additionalProperties": false,
            "properties": {
              "column": { "type": "string" },
              "type": { "type": "string", "enum": ["int64", "float64", "string", "boolean", "timestamp", "date"] },
              "displayName": { "type": "string" },
              "desiredDirection": { "type": "string", "enum": ["increase", "decrease"] }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column"],
            "additionalProperties": false,
            "properties": {
              "column": { "type": "string" },
              "type": { "type": "string", "enum": ["int64", "float64", "string", "boolean", "timestamp", "date"] }
            }
          }
        }
      }
    },
    "Metric": {
      "type": "object",
      "required": ["metricType"],
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "metricType": {
          "type": "string",
          "enum": ["conversion_rate", "sum", "count", "ratio", "funnel", "percentile"]
        },
        "event": { "type": "string" },
        "fact": { "type": "string" },
        "measure": { "type": "string" },
        "desiredDirection": { "type": "string", "enum": ["increase", "decrease"] },
        "unit": { "type": "string" },
        "winsorizeAt": { "type": "number", "minimum": 0, "maximum": 1 },
        "certified": { "type": "boolean" },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "operator", "values"],
            "additionalProperties": false,
            "properties": {
              "dimension": { "type": "string" },
              "operator": { "type": "string", "enum": ["equals", "not_equals", "in", "not_in"] },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "timeframe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startDays": { "type": "integer", "minimum": 0 },
            "endDays": { "type": "integer", "minimum": 0 }
          }
        },
        "numerator": {
          "type": "object",
          "required": ["fact", "measure"],
          "additionalProperties": false,
          "properties": {
            "fact": { "type": "string" },
            "measure": { "type": "string" }
          }
        },
        "denominator": {
          "type": "object",
          "required": ["fact", "measure"],
          "additionalProperties": false,
          "properties": {
            "fact": { "type": "string" },
            "measure": { "type": "string" }
          }
        },
        "percentile": { "type": "number", "minimum": 0, "maximum": 1 },
        "funnelSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": { "type": "string" },
              "fact": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
